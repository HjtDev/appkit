# cp playground/.env.example playground/.env, then generate DEMO_FERNET_KEY:
#   cd backend && uv run python -c "from appkit.crypto import generate_key; print(generate_key())"
#
# This is demo/'s OWN key (playground/backend/demo/fields.py), never appkit's — appkit.crypto
# reads zero settings/.env keys of its own, by design (docs/CONTRACT.md §3).
DEMO_FERNET_KEY=
